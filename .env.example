# ---------------------------------------------------------------------------
# RecruiMate — copy to .env and fill only what you need.
# The app works offline with DEFAULT_PROVIDER=heuristic (no key required).
# ---------------------------------------------------------------------------

APP_NAME=RecruiMate
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/recruimate.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional bearer token for the API. Leave empty for trusted local use.
API_TOKEN=

# --- Authentication (accounts, login, per-user data isolation) --------------
# Set AUTH_ENABLED=true to enable register/login/JWT. While false the app runs
# in trusted-local mode: no login screen, one implicit user.
AUTH_ENABLED=false
JWT_SECRET=change-me-local-dev-secret
SEED_DEMO_ACCOUNTS=false
# When seeding is on and auth is enabled, candidate1..5@example.com are created
# on first boot with password RecruiMate@123 (demo data included).

DEFAULT_PROVIDER=heuristic
REQUEST_TIMEOUT=60
MAX_RETRIES=2
# Never silently switch to a paid model when a free provider fails.
ALLOW_PAID_FALLBACK=false

# --- OpenRouter (recommended fallback provider) -----------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Check GET /api/providers/models?provider=openrouter for current slugs:
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Groq (recommended first integration) -----------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# --- Google Gemini ----------------------------------------------------------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash

# --- Self-hosted OpenCode server (session API, NOT /v1/chat/completions) -----
# OPENCODE_SERVER_PASSWORD=secret opencode serve --hostname 127.0.0.1 --port 8080
OPENCODE_BASE_URL=http://127.0.0.1:8080
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=
OPENCODE_MODEL=opencode

# --- Ollama (local, OpenAI-compatible) --------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2

# --- Custom OpenAI-compatible endpoints -------------------------------------
# Comma-separated hosts. Keep this narrow: it prevents SSRF.
ALLOWED_CUSTOM_HOSTS=localhost,127.0.0.1,::1
ALLOW_PRIVATE_HOSTS=true

# --- Embeddings -------------------------------------------------------------
# auto: use sentence-transformers when installed, else hashed TF-IDF fallback.
# Set to hashed to skip the optional model download entirely.
EMBEDDINGS_BACKEND=auto
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
